{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "048fc8a39fa65b03d33a46dce2724ca6",
  "routes": [{ "pattern": "api.amindadgar.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "CACHE", "id": "25d93c1cae584f3fa19529ab4a7d46e6" }],
  // Daily GitHub summary refresh (05:00 UTC).
  "triggers": { "crons": ["0 5 * * *"] },
  "vars": {
    "GITHUB_USERNAME": "amindadgar",
    "SUMMARY_WINDOW_DAYS": "30",
    // OpenRouter model plus fallbacks, tried in order; all must support structured outputs. ~$0.002 per daily run.
    "SUMMARY_MODELS": "google/gemini-3.1-flash-lite,google/gemma-4-31b-it,qwen/qwen3.8-flash",
    "ALLOWED_ORIGINS": "https://amindadgar.com,https://www.amindadgar.com,http://localhost:8080"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, or in .dev.vars for local dev):
  //   OPENROUTER_API_KEY  - OpenRouter key (set a credit limit on it in the OpenRouter dashboard)
  //   GITHUB_TOKEN        - fine-grained, read-only, public repositories only
  //   ADMIN_TOKEN         - random string guarding POST /admin/refresh-github-summary
}
